{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"./scripts/hook-runner.mjs\" session-start",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"./scripts/hook-runner.mjs\" auto-recall",
        "timeout": 25
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node \"./scripts/hook-runner.mjs\" uri-guard",
        "timeout": 10
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node \"./scripts/hook-runner.mjs\" capture",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"./scripts/hook-runner.mjs\" capture",
        "timeout": 30
      }
    ]
  }
}