{
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/session-start.mjs\"",
        "timeout": 30
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/auto-recall.mjs\"",
        "timeout": 25
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/uri-guard.mjs\"",
        "timeout": 10
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/capture.mjs\"",
        "timeout": 30
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/scripts/capture.mjs\"",
        "timeout": 30
      }
    ]
  }
}