{
  "hooks": {
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}\\scripts\\auto-recall.mjs\"",
        "timeout": 25
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\scripts\\capture.ps1\"",
        "timeout": 30
      }
    ]
  }
}
